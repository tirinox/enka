# ---------------------------------------------------------------------------
# Enka — copy this file to `.env` and edit.  `make up` will do the copy for you.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=enka
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=enka
# Host port for the database (dev override only). Change if 5432 is taken.
POSTGRES_HOST_PORT=5433

# --- API ------------------------------------------------------------------
API_PORT=8000

# The short secret you type into the Enka client once; it is exchanged for a
# JWT.  Anything goes, but make it long enough that it can't be guessed.
#   generate:  openssl rand -hex 16
ENKA_ACCESS_SECRET=change-me

# Key used to sign JWTs.  Changing it invalidates every issued token.
#   generate:  openssl rand -hex 32
ENKA_JWT_SECRET=change-me-as-well

# How long a client stays logged in (hours). 720 = 30 days.
ENKA_JWT_TTL_HOURS=720

# Display name of the single owner this instance serves.
ENKA_OWNER_NAME=me

# --- Uploads --------------------------------------------------------------
ENKA_MAX_AUDIO_MB=25

# --- Auto-generated term audio ---------------------------------------------
# Speaks a new card's term aloud on creation, in whatever language it
# detects (restricted to the languages below). Set to false to disable.
ENKA_TTS_ENABLED=true
# lang:voice pairs. Voice files ship in the image at /data/tts-voices — add
# a language by dropping its .onnx + .onnx.json there and adding it here.
ENKA_TTS_VOICE_MAP=en:en_US-lessac-medium,ru:ru_RU-irina-medium
# Below this confidence (0-1), a term is left with no audio rather than
# guessed at.
ENKA_TTS_MIN_CONFIDENCE=0.75

# --- AI-generated definitions/translations ----------------------------------
# Any OpenAI-compatible /chat/completions provider. Not ENKA_-prefixed —
# these are pasted straight from the provider's dashboard.
#   DeepSeek: https://platform.deepseek.com/api_keys, model deepseek-v4-flash
#   OpenRouter: https://openrouter.ai/settings/keys, model
#     deepseek/deepseek-v4-flash, AI_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_URL=https://api.deepseek.com
# DeepSeek thinks before answering by default: 10-25 s per card instead of
# under one, for no better a translation. true turns it off, in DeepSeek's
# or OpenRouter's dialect depending on AI_URL. Set false for a provider that
# rejects fields it doesn't know (OpenAI does).
AI_DISABLE_THINKING=true

# --- FSRS scheduling ------------------------------------------------------
# Probability of recall you are aiming for. Higher = more frequent reviews.
ENKA_FSRS_DESIRED_RETENTION=0.9
# Cap on how far ahead a card can be scheduled, in days.
ENKA_FSRS_MAXIMUM_INTERVAL=36500
# Randomise intervals slightly so reviews don't clump on one day.
ENKA_FSRS_ENABLE_FUZZING=true

# --- Production -------------------------------------------------------------
# On the server only. Layers docker-compose.prod.yml over the base file, so
# plain `docker compose` and every make target run in production mode there,
# and the dev override is never picked up. Leave it commented out elsewhere.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Misc -----------------------------------------------------------------
ENKA_ENV=dev
ENKA_LOG_LEVEL=INFO
# Comma-separated, or * for anything. Tighten this before exposing the API.
ENKA_CORS_ORIGINS=*

# --- Apple clients (macOS and iOS) ------------------------------------------
# The server a fresh install starts with: `make mac`, `make ios` and `make
# ios-device` bake it into the app, and the sign-in field comes prefilled with
# it. An address the app has already connected to is saved and still wins.
# Empty means http://localhost:8010, which is what `make up` serves on.
# CLIENT_DEFAULT_SERVER=https://enka.example.com

# --- macOS client ---------------------------------------------------------
# Nothing here reaches the server; `make mac` reads it when it signs the app.
#
# Left empty, the bundle is ad-hoc signed — which works, but an ad-hoc identity
# is the binary's own hash, so every rebuild looks to macOS like a different
# application asking for the same keychain item. That is the recurring
# "Enka wants to access key com.enka.app" prompt, and why Always Allow does not
# survive the next build.
#
# Name a code-signing certificate here and the identity stops moving: granted
# once, it holds. `make mac-identity` lists what you have and explains how to
# make one if you have none. A self-signed certificate is enough — the app
# never leaves your Mac, so it needs nothing from Apple.
#
# MACOS_CODESIGN_IDENTITY=Enka Dev

# --- iOS client -----------------------------------------------------------

# Overrides the signing team `make ios-device` builds with. Only needed to sign
# with something other than what the Xcode project already says — normally the
# project's own DEVELOPMENT_TEAM is right, and the simulator needs no team at
# all. Ten characters; it is a team id, not the name on the certificate.
#
# IOS_DEVELOPMENT_TEAM=ABCDE12345
